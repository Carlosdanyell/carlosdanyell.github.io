{
  "name": "carlosdanyell-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "fonts": "node scripts/subset-fonts.mjs",
    "predev": "npm run fonts",
    "dev": "vite",
    "prebuild": "npm run fonts",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "images": "node scripts/process-images.mjs"
  },
  "dependencies": {
    "@fontsource-variable/sora": "^5.3.0",
    "geist": "^1.7.2",
    "lenis": "^1.3.26",
    "motion": "^13.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
